# Copy to .env and fill in. Never commit .env.

# Live station AQI (optional; Open-Meteo is used when missing)
# https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Active fire detections for Smoke Trail
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# School circular + AI assistant
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to try first (defaults: gemini-3.5-flash, then fallbacks)
GEMINI_MODEL=

# Local dev server port (frontend proxies /api here)
PORT=5050
