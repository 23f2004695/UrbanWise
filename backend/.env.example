# Copy to .env and fill in. Never commit .env.
# Air quality, winds and NASA fire data need no keys.

# Parent notices, the assistant and Punjabi read-aloud
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model to try first (defaults: gemini-3.5-flash, then fallbacks)
GEMINI_MODEL=

# Local dev server port (frontend proxies /api here)
PORT=5050
# Set to 1 for auto-reload and error pages while developing. Never in production.
FLASK_DEBUG=

# Only when deployed behind proxies: how many add themselves to X-Forwarded-For
# (used to find the visitor's real address for rate limiting). Leave empty locally.
TRUSTED_PROXIES=
